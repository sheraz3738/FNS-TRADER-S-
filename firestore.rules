rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isFnsAdmin() {
      return request.auth != null
        && request.auth.token.email == 'customer_3343738405@fns.com';
    }

    // Customer app can view the product catalogue.
    // Only the designated admin can add, edit, or delete products.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isFnsAdmin();
    }

    // Business records are private to the admin account.
    match /invoices/{invoiceId} {
      allow read, write: if isFnsAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isFnsAdmin();
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
